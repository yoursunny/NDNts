{
  "name": "@ndn/root",
  "private": true,
  "scripts": {
    "build": "bash mk/build.sh",
    "clang-format": "git ls-files '*.cpp' | xargs -r clang-format-20 -i -style=file",
    "cover": "bash mk/build.sh cover",
    "lint": "bash mk/build.sh lint",
    "literate": "bash mk/literate.sh",
    "postinstall": "bash mk/bootstrap.sh",
    "preinstall": "npx only-allow pnpm",
    "shfmt": "git ls-files -- '*.sh' | xargs -r docker run --rm -u $(id -u):$(id -g) -v $PWD:/mnt -w /mnt mvdan/shfmt:v3 -l -w -s -i=2 -ci",
    "test": "vitest",
    "typedoc": "bash mk/typedoc.sh"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "devDependencies": {
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@yoursunny/xo-config": "0.1002.0",
    "codedown": "^3.3.0",
    "tslib": "^2.8.1",
    "typedoc": "0.28.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^24.12.0 || ^26.2.0"
  }
}
